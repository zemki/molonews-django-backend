# Vorlage für die Konfiguration einer molo-Instanz.
# Kopieren nach ".env" und ausfüllen. Die Datei .env niemals committen.

# --- Django -----------------------------------------------------------------
# Erzeugen z. B. mit: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Kommagetrennt, z. B. backend.example.org,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Kommagetrennt mit Schema, z. B. https://backend.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional, wenn Cookies über Subdomains geteilt werden sollen, z. B. .example.org
DJANGO_COOKIE_DOMAIN=
DJANGO_TIME_ZONE=Europe/Berlin
# Öffentliche URL dieser Instanz (mit Slash am Ende)
SERVER_URL=http://localhost:8000/
# Nur Produktion: HSTS-Dauer in Sekunden (erst setzen, wenn HTTPS überall läuft)
# und Weiterleitung auf HTTPS durch Django (unnötig, wenn nginx das macht)
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=false

# --- Datenbank (PostgreSQL) -------------------------------------------------
# Zum Ausprobieren ohne PostgreSQL: DB_ENGINE=django.db.backends.sqlite3
# (Datei db.sqlite3 im Projekt oder SQLITE_PATH=/pfad/datei.sqlite3; die
# übrigen DB_-Werte werden dann ignoriert)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=molo
DB_USER=molo
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Verzeichnisse (Standard: Unterordner im Projekt) -----------------------
# STATIC_ROOT=/srv/molo/www/static
# MEDIA_ROOT=/srv/molo/www/media
# LOG_DIR=/srv/molo/logs
# IMPORT_DATA_DIR=/srv/molo/import_data
# IMPORT_SCRIPTS_DIR=/srv/molo/import_scripts
# BACKUP_DIR=/srv/molo/backups

# --- CORS -------------------------------------------------------------------
# Kommagetrennt, z. B. https://app.example.org
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=false

# --- Authentifizierung / Tokens ---------------------------------------------
# Leer = DJANGO_SECRET_KEY wird verwendet
JWT_SECRET_KEY=
JWT_ACCESS_DAYS=180
JWT_REFRESH_DAYS=240
# Gültigkeit von Passwort-Reset-Links in Stunden
PASSWORD_RESET_TIMEOUT_HOURS=24
# Ratenbegrenzung pro Client-IP (zusätzlich zu nginx)
THROTTLE_RATE_AUTH=20/min
THROTTLE_RATE_MAIL=10/hour
THROTTLE_RATE_AI=30/min
# Anzahl Reverse-Proxys vor Django (nginx = 1, ohne Proxy = 0)
TRUSTED_PROXY_COUNT=1
# Token für externe Datei-/Bild-Uploads
UPLOAD_AUTH_TOKEN=
# API-Key für externe Tagging-Worker
AI_TAGGING_API_KEY=

# --- E-Mail -----------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Deep-Link der App für den Passwort-Reset
PASSWORD_RESET_URL=molo://password-reset/
# Empfänger für Fehler- und Monitoring-Meldungen
ERROR_NOTIFICATION_EMAIL=
# Empfänger für Feedback, Kontaktformulare und gemeldete Inhalte
FEEDBACK_MAIL_TARGET=

# --- Öffentliche Angaben ----------------------------------------------------
WEBSITE_URL=
CONTACT_EMAIL=
APP_STORE_URL=
PLAY_STORE_URL=
# Nominatim verlangt einen User-Agent mit eigener Kontaktadresse; Beispielwerte
# lehnt es ab (HTTP 403)
GEOCODER_USER_AGENT=molo-backend (admin@example.org)

# --- Inhalte ---------------------------------------------------------------
# Gebiete für Geräte ohne eigene Gebietswahl (kommagetrennte Area-IDs, leer = alle)
DEFAULT_AREA_IDS=
# RSS-Quellen, die nur einmal täglich abgerufen werden (kommagetrennte Source-IDs)
IMPORT_DAILY_SOURCE_IDS=
# Ersatz-Thema für importierte Artikel/Events ohne Themen (Tag-IDs, leer = keins)
IMPORT_FALLBACK_ARTICLE_TAG_ID=
IMPORT_FALLBACK_EVENT_TAG_ID=
# Quellen, deren Artikel die Duplikatbereinigung nie löscht (kommagetrennte Source-IDs)
DUPLICATE_PROTECTED_SOURCE_IDS=
# Quellen, deren eingereichte Events ohne Tags vor der Veröffentlichung über
# /api/v4/events/preview/ abrufbar sind (kommagetrennte Source-IDs, leer = keine)
EVENT_PREVIEW_SOURCE_IDS=
# Willkommensbeitrag für neu angelegte Gebiete: Source-ID (leer = kein Beitrag) und Tag-ID (optional)
AREA_WELCOME_SOURCE_ID=
AREA_WELCOME_TAG_ID=
# Quellen-Links auf interne Adressen erlauben (nur Entwicklung, sonst SSRF-Risiko)
ALLOW_PRIVATE_IMPORT_URLS=false

# --- Monitoring -------------------------------------------------------------
# Benutzer-ID für den Schreibtest der API (leer = Test aus)
MONITORING_USER_ID=

# --- Push-Nachrichten (optional) --------------------------------------------
ENABLE_PUSH=false
# Pfad zur Service-Account-JSON außerhalb des Repositorys
FIREBASE_SERVICE_ACCOUNT_KEY=
# Zugangscode für den Push-Test-Endpunkt (leer = gesperrt)
PUSH_TEST_ACCESS_CODE=

# --- Celery -----------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# --- Lokale Sprachmodelle (Ollama) ------------------------------------------
LLM_BASE_URL=http://localhost:11434
# gpt-oss:20b (ca. 16 GB RAM/VRAM) oder gpt-oss:120b (ca. 80 GB)
LLM_MODEL=gpt-oss:20b
# Optional eigenes Modell für die Scraper-Generierung, z. B. gpt-oss:120b
LLM_CODEGEN_MODEL=
# Reasoning-Stufe: low, medium oder high
LLM_THINK=low
LLM_TIMEOUT=120
LLM_NUM_CTX=8192

# --- KI-Event-Suche ---------------------------------------------------------
USE_RAG_EVENT_SEARCH=false
RAG_CACHE_TIMEOUT=120
RAG_SEARCH_DEBUG=false

# --- Spracheingabe (optional, benötigt: pip install faster-whisper) ---------
SPEECH_TO_TEXT_ENABLED=false
WHISPER_MODEL=small
WHISPER_DEVICE=auto
